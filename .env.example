# =====================================================================
#  GodsEye settings — copy this file to ".env" (npm run setup does it)
#  Lines starting with # are notes. Empty values use the default shown.
# =====================================================================

# ---------------------------------------------------------------------
# THE BIG SWITCH
# real  = copy trades spend REAL SOL from GodsEye's wallet (default)
# paper = simulate copy trades with live Jupiter quotes, nothing is sent
# Pause new buys any time:  npm run pause   (or create a file data/PAUSE)
# ---------------------------------------------------------------------
COPY_MODE=real

# ---------------------------------------------------------------------
# API KEYS
# ---------------------------------------------------------------------
# Helius — strongly recommended. Analysis reads a lot of wallet history and the
# public RPC is slow and rate-limited. https://dev.helius.xyz (free tier works)
HELIUS_API_KEY=
# Your paid HTTPS RPC (overrides Helius), e.g. Shyft: https://rpc.shyft.to?api_key=<key>
# and its websocket URL if it isn't the same host with wss:// (Shyft: wss://rpc.shyft.to?api_key=<key>)
SOLANA_RPC_URL=
SOLANA_WS_URL=
# RPC for the copy path only (leader transactions, rug checks, the agent wallet, sending
# trades), so history reads using up SOLANA_RPC_URL's quota never slow a copy.
# Empty = Helius (with HELIUS_API_KEY), else SOLANA_RPC_URL.
COPY_RPC_URL=
COPY_WS_URL=
# Jupiter works WITHOUT a key (free "lite" API). Optional key: https://portal.jup.ag
JUPITER_API_KEY=
# Birdeye — optional backup price feed. https://docs.birdeye.so
BIRDEYE_API_KEY=

# ---------------------------------------------------------------------
# LIVE gRPC STREAM — every DEX swap on Solana, as it confirms
# Any Yellowstone-protocol gRPC works: Shyft, Triton, Helius, QuickNode.
#   Shyft example: GRPC_URL=https://grpc.ny.shyft.to   GRPC_TOKEN=<your Shyft gRPC token>
# Leave empty to fall back to sampling busy pools every 30 minutes.
# ---------------------------------------------------------------------
GRPC_URL=
GRPC_TOKEN=
# While Shyft rejects this connection's IP (allowlist), retry this often (ms); the stream holds on once in.
# STREAM_IP_RETRY_MS=10000
# Programs to stream (default: pump.fun, PumpSwap, Raydium, Orca, Meteora, Jupiter)
STREAM_PROGRAMS=
# Promote a live wallet to full analysis at this realized profit (USD at settlement)...
# (hard floor: never below 25, whatever is set here)
STREAM_PROMOTE_PNL_USD=50
# ...over at least this many closed trades, with >= 50% wins (hard floor: 2)
STREAM_PROMOTE_MIN_CLOSED=2
STREAM_MAX_WALLETS=300000
STREAM_IDLE_HOURS=6
# Who parses the live stream (default ts = the TypeScript parser, unchanged).
#   rust    = take parsed swaps from the Rust ingest service (rust/ingest, ge-ingest) over GE_INGEST_SOCKET;
#             the agent does not open its own gRPC stream. ge-ingest needs GRPC_URL/GRPC_TOKEN itself.
#   compare = keep the TypeScript results and also read ge-ingest, logging differences every minute.
#             Both open a gRPC stream: check your provider allows two connections per token.
# STREAM_PARSER=ts
# GE_INGEST_SOCKET=/tmp/godseye-ingest.sock
ACTIVITY_RETENTION_DAYS=30
# Delete raw wallet_swaps older than this many days (0 = keep forever). closed_trades keeps every round trip;
# swaps of copied wallets and wallets with an open position are never pruned.
SWAPS_RETENTION_DAYS=90
# Daily housekeeping (retention pruning + WAL checkpoint), UTC
PRUNE_CRON=17 3 * * *

# ---------------------------------------------------------------------
# SELF-ADJUSTING FOLLOW BAR — the min win rate to follow a wallet is LEARNED
# from how following worked out (copy trades, or shadow copies of smart buys).
# These only set where it starts and the limits it moves within.
# ---------------------------------------------------------------------
FOLLOW_WIN_RATE_START=0.5
FOLLOW_WIN_RATE_FLOOR=0.4
FOLLOW_WIN_RATE_CEILING=0.8
# Max change per learning cycle (15 min), and outcomes needed before it moves
FOLLOW_MAX_STEP=0.05
FOLLOW_MIN_SAMPLES=20

# ---------------------------------------------------------------------
# SMART MONEY — who counts, and when their moves become a signal
# ---------------------------------------------------------------------
# Wallets winning on the live stream count as smart money from this profit (USD)...
SMART_LIVE_MIN_PNL_USD=250
# ...over at least this many closed trades (with >= 55% wins)
SMART_LIVE_MIN_CLOSED=5
# A signal = this many smart wallets buying (or dumping) the same token...
SMART_SIGNAL_WALLETS=3
# ...within this many minutes, for at least this much USD
SMART_SIGNAL_WINDOW_MINUTES=60
SMART_SIGNAL_MIN_USD=500
# Learned: a wallet whose buys have this median 6h return (%) or worse (10+ measured) stops counting as smart
SMART_DROP_MEDIAN_RET_6H=-15
# Organic tokens: a smart-money flow or signal only counts if the token has real, independent demand. The stream keeps a tally of
# every swap by every wallet and judges each token: organic / thin / wash / unknown (too early). Thresholds are first guesses.
ORGANIC_ENABLED=true
# different wallets that have traded it, buyers among them, and of those how many are not smart wallets
ORGANIC_MIN_MAKERS=15
ORGANIC_MIN_BUYERS=8
ORGANIC_MIN_OUTSIDE_BUYERS=5
# volume spread over at least this many equivalent wallets (1 / Herfindahl); largest wallet's and top 3's share of volume at most
ORGANIC_MIN_EFFECTIVE_MAKERS=6
ORGANIC_MAX_TOP1_SHARE=0.5
ORGANIC_MAX_TOP3_SHARE=0.8
# wash: share of volume that is a wallet buying and selling the same tokens back (within this many seconds, to within this share)
ORGANIC_MAX_ROUND_TRIP_SHARE=0.3
ORGANIC_ROUND_TRIP_WINDOW_SEC=180
ORGANIC_ROUND_TRIP_TOLERANCE=0.05
# a token younger than this many minutes with fewer swaps than this is "unknown", not "thin"
ORGANIC_JUDGE_AFTER_MINUTES=10
ORGANIC_MIN_SWAPS=20
# memory: wallets kept per token, tokens kept, minutes a quiet token is kept
ORGANIC_MAX_MAKERS_PER_MINT=64
ORGANIC_MAX_MINTS=30000
ORGANIC_IDLE_MINUTES=120
# Market check: ask Jupiter (free, keyless) every few minutes whether the tokens smart money trades still have a pool with money.
# A pool holding less than this (USD), or a token Jupiter has never heard of after this many minutes, is left out of the feed.
ORGANIC_MARKET_CHECK=true
ORGANIC_MIN_LIQUIDITY_USD=500
ORGANIC_NO_LISTING_AFTER_MINUTES=15
ORGANIC_MARKET_EVERY_SECONDS=90
ORGANIC_MARKET_PER_RUN=50
# Meteora's bonding curve (DBC) and its DAMM v2 pools are labelled when seen, but the stream does not subscribe to them (that floods
# wallet promotion with volume-farm wallets). To receive them anyway, list the program ids in STREAM_PROGRAMS.
# Bot gate: not smart money if its median hold is under this many seconds,
SMART_BOT_MIN_HOLD_SEC=15
# or it makes more than this many transactions an hour,
SMART_BOT_MAX_TX_PER_HOUR=20
# or more than this many of its positions (30 days) were bought and sold in the same block
SMART_BOT_MAX_SAME_BLOCK=0
# Copy gate: replaying GodsEye's copies of it at the real delay must have a positive median return,
# over at least this many copies, with other swaps seen near at least this share of entries
SMART_REPLAY_MIN_COPIES=10
SMART_REPLAY_MIN_COVERAGE=0.5
# Delay to replay at (seconds) until real copies measure it
SMART_REPLAY_DELAY_SEC=5
# The copy must still pay at this multiple of that delay (the worse of the two replays is what the gate sees); 1 = off
SMART_REPLAY_STRESS_FACTOR=3
# A median copy return above this (%) isn't believable (the replay is pricing against a scripted tape), so it fails the gate
SMART_REPLAY_MAX_MEDIAN_PCT=100

# ---------------------------------------------------------------------
# COPY TRADING — money limits (real SOL)
# ---------------------------------------------------------------------
# Most SOL GodsEye may have in open copy positions at once (shared out by leader weight)
COPY_BUDGET_SOL=1
# Per-trade size limits (hard ceiling in code: 5 SOL)
COPY_MIN_TRADE_SOL=0.01
COPY_MAX_TRADE_SOL=0.1
COPY_MAX_POSITIONS=5
# Stop opening positions for the rest of the UTC day after this much realized loss
COPY_DAILY_LOSS_LIMIT_SOL=0.5
# Always leave this much SOL in the wallet for fees
WALLET_RESERVE_SOL=0.05
# GodsEye's own exits, even if the leader never sells
COPY_STOP_LOSS_PCT=35
COPY_TAKE_PROFIT_PCT=300
COPY_MAX_HOLD_HOURS=48
# Skip a leader's trade if GodsEye sees it later than this (price has moved)
COPY_MAX_DELAY_SECONDS=60
# Ignore leader buys smaller than this (dust / tests)
MIN_LEADER_BUY_SOL=0.2
COPY_SLIPPAGE_BPS=300
PRIORITY_FEE_MAX_LAMPORTS=1000000
POSITION_CRON=* * * * *
LEADER_POLL_SECONDS=30

# ---------------------------------------------------------------------
# LEARNING LOOP — who to copy
# ---------------------------------------------------------------------
LEARN_CRON=*/15 * * * *
# Copy at most this many wallets at once (the top earners)
COPY_MAX_LEADERS=10
# The most of the copy budget one leader can hold (0.25 = a quarter; 1 = no cap)
COPY_MAX_LEADER_SHARE=0.25
# A leader's weight scales with the share of its buys (14 days) in coins the rug screen passes: pump.fun coins, or coins
# already screened as passing. Below this share it isn't copied at all, since its buys would nearly all be skipped. 0 = off
COPY_MIN_COPYABLE_SHARE=0.3
# Drop a leader if GodsEye's own copies of it lost this much over 14 days
COPY_LOSS_DROP_SOL=0.2

# ---------------------------------------------------------------------
# DISCOVERY + ANALYSIS — building the wallet database
# ---------------------------------------------------------------------
DISCOVER_CRON=*/30 * * * *
# Pools read per run (GeckoTerminal is paced at ~9 calls/min, so 40 pools take about 5 minutes)
DISCOVER_POOLS=40
DISCOVER_MIN_TRADE_USD=300
DISCOVER_MAX_NEW_PER_RUN=100
ANALYZE_CRON=*/10 * * * *
ANALYZE_PER_RUN=90
# Wallets analyzed at the same time (each mostly waits on the network; RPC_MAX_RPS sets the overall pace).
ANALYZE_CONCURRENCY=12
# Transactions read the first time a wallet is analyzed
# First look at a wallet: read this many days back, but at most HISTORY_TX_LIMIT transactions (busy bots trade thousands a day).
HISTORY_DAYS=7
HISTORY_TX_LIMIT=1000
# Promising wallets (copied, smart money, proven or profitable) are then read back up to this many transactions.
HISTORY_DEEP_TX_LIMIT=5000
# Wallets studied before deeper history: how many to read further back per analysis run.
HISTORY_DEEPEN_PER_RUN=6
# Steady cap on wallet-history RPC requests per second (each transaction counts). Shyft Build allows 100/sec; 75 leaves room for copy trading.
RPC_MAX_RPS=75
# Share of RPC_MAX_RPS reserved for copy trading (watcher, executor). Wallet-history reads are paced at the rest
# (0.2 -> analysis at most 60/sec of 75) and slow down further while copy calls exceed the reserve.
# Only applies when the copy path shares this RPC (COPY_RPC_URL empty and no HELIUS_API_KEY).
RPC_COPY_RESERVE=0.2
REANALYZE_MINUTES=60
# A wallet the learning loop found to be a bot is re-read only this often (days).
BOT_REANALYZE_DAYS=7
# A wallet younger than this is "fresh"
FRESH_WALLET_DAYS=3
# Never track these wallets (exchanges, your own…), comma-separated
IGNORE_WALLETS=

# ---------------------------------------------------------------------
# TIERS
# ---------------------------------------------------------------------
# Quitter after this many days without a swap
QUIT_AFTER_DAYS=7
# A buy this many seconds after a token's first pool counts as "launch-minute"
EARLY_BUY_SECONDS=600
# Closed trades in 30 days needed for "Proven" (fewer = "Lucky streak"), and before GodsEye copies a wallet
MIN_CLOSED_FOR_PROVEN=10
# "Sold right before a crash" (insider signal): the token fell this much (%)...
CRASH_DROP_PCT=50
# ...within this many minutes of a sale made near the top...
CRASH_WINDOW_MINUTES=60
# ...at least this many times, making up at least this share of the wallet's closed trades
CRASH_MIN_EXITS=3
CRASH_MIN_SHARE=0.25

# ---------------------------------------------------------------------
# RUG CHECKS (before copying any buy)
# ---------------------------------------------------------------------
RUG_CHECK_ENABLED=true
RUG_BLOCK_MINT_AUTHORITY=true
RUG_MAX_RISK_SCORE=75
# Skip coins whose liquidity isn't locked or burned: the share of pool liquidity (in USD, across all pools)
# that's locked or burned must be at least this %. Pump.fun coins count as locked (curve / burned LP). 0 = off.
LP_MIN_LOCKED_PCT=90
# Orca / Raydium CLMM / Meteora DLMM hold positions, not LP tokens, so "% locked" does not describe them. block = count them like any pool
# (the default, strictest); warn = leave them out of the figure and note it, so a deep established coin is not refused for it.
LP_CONCENTRATED_POOLS=block
# Token-2022 coins that take at least this many basis points on every transfer (a tax on each buy and sell) are skipped. 1000 = 10%.
RUG_MAX_TRANSFER_FEE_BPS=1000
RUG_ALLOWLIST=

# ---------------------------------------------------------------------
# HOSTED WEBSITE (Vercel) — see README → "Host the website on Vercel"
# ---------------------------------------------------------------------
TURSO_DATABASE_URL=
# On GodsEye's computer: a FULL-ACCESS token. (On Vercel: a READ-ONLY token.)
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------
# DASHBOARD
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
# Advanced: use a different database file
GODSEYE_DB_PATH=
# Bundled / clustered coins: skip a copy buy if more than BUNDLE_MAX_PCT of supply was bought in the coin's first two slots,
# top holders funded by one wallet (or the creator) hold more than CLUSTER_MAX_PCT, the top 10 hold more than TOP10_MAX_PCT,
# or a RugCheck insider network holds more than INSIDER_MAX_PCT. If holders can't be read in HOLDER_CHECK_TIMEOUT_MS, skip.
HOLDER_CHECK_ENABLED=true
BUNDLE_MAX_PCT=25
CLUSTER_MAX_PCT=15
TOP10_MAX_PCT=50
INSIDER_MAX_PCT=20
HOLDER_CHECK_TIMEOUT_MS=8000

# Shadow log (`npm run shadow`): rug-screen and follow every token a leader buys, whether or not GodsEye copies it, so cutoffs
# can be judged on outcomes. Observation only; it needs no SOL. Costs about one holder check per new token on your RPC.
SHADOW_ENABLED=true
# Screens running at once, and how many may wait (beyond that a token is logged without a screen)
SHADOW_MAX_SCREENS=2
SHADOW_MAX_QUEUE=40

# Decision audit trail (`npm run audit`): why each wallet is in its state, and every check on every leader buy GodsEye considered.
AUDIT_ENABLED=true
# A copyability gate that only LOGS: quotes each candidate at GodsEye's size (price impact, drift from the leader's price, a
# buy-then-sell round trip, fees) and records what it would have decided. It never blocks a copy. Needs no SOL.
GATE_LOG_ENABLED=true
# What it would block on: price impact %, price already above the leader's %, round-trip loss %, worst-case fees as % of the trade
GATE_MAX_IMPACT_PCT=3
GATE_MAX_DRIFT_PCT=15
GATE_MAX_ROUND_TRIP_LOSS_PCT=15
GATE_MAX_FEE_PCT=5
# The pool(s) a buy goes through must be able to take this many times the position back before the price falls GATE_EXIT_DROP_PCT %
# (read from the pool on chain; venues whose depth cannot be read add nothing)
GATE_MIN_EXIT_MULTIPLE=3
GATE_EXIT_DROP_PCT=20
# Be gentle with Jupiter: seconds between a token's quotes, ms between any two quotes, and a pause after "too many requests"
GATE_MIN_GAP_SECONDS=300
GATE_MIN_SPACING_MS=1200
GATE_RATE_LIMIT_PAUSE_SECONDS=60

# Dashboard: show the full internal feed (wallet address and balance, logs, copy reasons, tuning).
# Owner-only. Never set this on a public deployment.
# GODSEYE_FULL_FEED=1
