{
  "name": "@godseye/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GodsEye — finds profitable Solana wallets, tiers them, tells AI from human, and copy-trades the winners.",
  "scripts": {
    "agent": "NODE_OPTIONS=--max-old-space-size=8192 tsx src/index.ts",
    "discover": "tsx src/cli/discover.ts",
    "analyze": "tsx src/cli/analyze.ts",
    "learn": "tsx src/cli/learn.ts",
    "replay": "tsx src/cli/replay.ts",
    "strategy": "tsx src/cli/strategy.ts",
    "archive": "tsx src/cli/archive.ts",
    "shadow": "tsx src/cli/shadow.ts",
    "audit": "tsx src/cli/audit.ts",
    "pool": "tsx src/cli/pool.ts",
    "wallet": "tsx src/wallet/cli.ts",
    "status": "tsx src/cli/status.ts",
    "stream:ips": "tsx src/cli/stream-ips.ts",
    "pause": "tsx src/cli/pause.ts pause",
    "resume": "tsx src/cli/pause.ts resume",
    "publish-dashboard": "tsx src/publish/cli.ts",
    "rust:fixtures": "tsx src/cli/rust-fixtures.ts",
    "bench:parse": "tsx src/cli/parse-bench.ts",
    "test": "tsx --import ../shared/test/setup.ts --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "backfill:closed": "tsx src/cli/backfill-closed.ts"
  },
  "dependencies": {
    "@godseye/shared": "*",
    "@solana/web3.js": "^1.98.0",
    "@triton-one/yellowstone-grpc": "8.0.0",
    "bs58": "^6.0.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
